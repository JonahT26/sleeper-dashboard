<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ league_name }} power rankings</title>
<meta name="description" content="Weekly power rankings, records, and awards for {{ league_name }}.">
<script>document.documentElement.classList.add("js", "preload");</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;600&display=swap" rel="stylesheet">
<script src="{{ plotly_cdn }}" defer></script>
<style>
{% include "styles.css" %}
</style>
</head>
<body>
{% macro diverging(b) -%}
<span class="div" aria-hidden="true"><span class="fill {{ b.side }}" style="left:{{ b.left }}%;width:{{ b.width }}%"></span><span class="mid"></span></span>
{%- endmacro %}

{% macro week_sections(v) %}
<section class="ladder-section" aria-labelledby="title">
  <p class="key">League average: 50</p>
  <ol class="ladder" role="list">
  {% for t in v.ladder %}
    <li class="team" data-roster="{{ t.roster_id }}">
      <details>
        <summary class="row">
          <span class="rank display num">{{ t.rank }}</span>
          <span class="l1"><span class="name">{{ t.team }}</span><span class="move {{ t.move.kind }} display num"><span aria-hidden="true">{{ t.move.text }}</span><span class="sr">{{ t.move.spoken }}</span></span></span>
          <span class="l2"><span class="user">{{ t.user }}</span><span class="rec num">{{ t.record }}</span></span>
          <span class="l3 score">{{ diverging(t.bar) }}<span class="val display num"><span class="sr">power score </span>{{ t.score }}</span></span>
        </summary>
        <div class="bd-body">
          <table class="parts">
            <caption class="sr">How {{ t.team }}'s power score is built</caption>
            <thead><tr><th scope="col">Component (weight)</th><th scope="col">Score</th><th scope="col">vs average</th></tr></thead>
            <tbody>
            {% for p in t.parts %}
              <tr>
                <th scope="row"><span class="comp">{{ p.label }} ({{ p.weight }})</span><span class="detail">{{ p.detail }}</span></th>
                <td class="sc num">{{ p.score }}</td>
                <td class="vs"><span class="vs-cell">{{ diverging(p.bar) }}<span class="vs-num num">{{ p.gap }}</span></span></td>
              </tr>
            {% endfor %}
              <tr class="total"><th scope="row">Power score</th><td class="num">{{ t.score }}</td><td class="num"><span class="vs-cell"><span class="vs-num">{{ t.gap }}</span></span></td></tr>
            </tbody>
          </table>
        </div>
      </details>
    </li>
  {% endfor %}
  </ol>
</section>
{% if v.odds %}
<section class="odds-section" aria-labelledby="odds-title-{{ v.week }}">
  <h2 class="section-title display" id="odds-title-{{ v.week }}">Playoff odds</h2>
  <p class="sub">{{ v.odds.subtitle }}</p>
  <div class="table-scroll">
    <table class="odds">
      <thead><tr><th scope="col">Team</th><th scope="col">Projected record</th><th scope="col">Playoffs</th><th scope="col">Bye</th><th scope="col">Title</th></tr></thead>
      <tbody>
      {% for r in v.odds.rows %}
        <tr data-roster="{{ r.roster_id }}">
          <th scope="row">{{ r.team }}</th>
          <td class="num">{{ r.record }}</td>
          <td class="num po"><span class="po-val">{{ r.playoffs }}</span><span class="po-bar" aria-hidden="true"><span style="width:{{ r.bar }}%"></span></span></td>
          <td class="num">{{ r.bye }}</td>
          <td class="num">{{ r.title }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <details class="seeds">
    <summary>Chance of each seed</summary>
    <div class="table-scroll">
      <table class="seed-table">
        <caption class="sr">Chance of each playoff seed; seeds 1 and 2 get a bye</caption>
        <thead><tr><th scope="col">Team</th>{% for s in v.odds.seeds %}<th scope="col"><span class="sr">Seed </span>{{ s }}</th>{% endfor %}</tr></thead>
        <tbody>
        {% for r in v.odds.rows %}
          <tr><th scope="row">{{ r.team }}</th>{% for c in r.seeds %}<td class="num" style="--p:{{ c.shade }}">{{ c.text }}</td>{% endfor %}</tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>
{% endif %}
{% if v.awards %}
<section class="awards" aria-labelledby="awards-title-{{ v.week }}">
  <h2 class="section-title display" id="awards-title-{{ v.week }}">Weekly awards</h2>
  <ul class="tiles" role="list">
  {% for a in v.awards %}
    <li class="tile">
      <h3 class="award display">{{ a.name }}</h3>
      <p class="award-value display num">{{ a.value }}</p>
      {% for w in a.winners %}
      <p class="winner">{{ w.team }}</p>
      <p class="caption">{{ w.caption }}</p>
      {% endfor %}
    </li>
  {% endfor %}
  </ul>
</section>
{% endif %}
{% if v.charts %}
<div class="charts">
{% for c in v.charts %}
<section class="chart-section{% if c.wide %} wide{% endif %}" aria-labelledby="{{ c.id }}-title">
  <h2 class="section-title display" id="{{ c.id }}-title">{{ c.title }}</h2>
  <p class="sub">{{ c.subtitle }}</p>
  <div class="chart" data-figure="{{ c.id }}" role="img" aria-label="{{ c.summary }}"
       style="--h-phone:{{ c.figure.height.phone }}px;--h-desktop:{{ c.figure.height.desktop }}px"><p class="chart-fallback">{{ c.summary }}</p></div>
  <script type="application/json" id="fig-{{ c.id }}">{{ c.figure_json|safe }}</script>
</section>
{% endfor %}
</div>
{% endif %}
{% endmacro %}

<header class="mast">
  <div class="wrap">
    <p class="league display">{{ league_name }}</p>
    <h1 class="title display" id="title">{{ latest.title }}</h1>
    <div class="week-pick"><label class="sr" for="week">Week</label>
      <select id="week">
      {% for w in weeks %}
        <option value="{{ w }}"{% if w == latest.week %} selected{% endif %}>Week {{ w }}</option>
      {% endfor %}
      </select>
    </div>
  </div>
</header>
{# Pinned to the top of the screen while scrolling, so the update time is always in view (UI_GUIDE.md "Status bar"). #}
<div class="status" id="status" data-updated="{{ updated_at }}"{% if stale %} data-stale-after-days="{{ stale.after_days }}"{% endif %}>
  <div class="wrap">
    <p class="updated">Updated <time datetime="{{ updated_at }}">{{ updated }}</time></p>
    {% if stale and stale.final %}
    <p class="stale" id="stale" hidden>Final rankings for the {{ season }} season.</p>
    {% elif stale %}
    <p class="stale" id="stale" hidden>The latest rankings are from week {{ latest.week }}.<span id="next-update" hidden> Next update due <span class="when"></span>.</span></p>
    <script type="application/json" id="next-updates">{{ stale.next_updates_json|safe }}</script>
    {% endif %}
  </div>
</div>
<main>
  <div class="wrap week-view" id="week-view" data-week="{{ latest.week }}">
{{ week_sections(latest) }}
  </div>
  <div class="wrap">
    {% if history %}
    {% macro history_rows(rows) %}
      {% for m in rows %}
        <tr>
          <th scope="row"><span class="h-name">{{ m.manager }}</span><span class="h-team">{{ m.detail }}</span></th>
          <td class="num">{{ m.record }}</td><td class="num">{{ m.win_pct }}</td>
          <td class="num">{{ m.playoffs }}</td><td class="num">{{ m.titles }}</td>
        </tr>
      {% endfor %}
    {% endmacro %}
    {% macro history_head() %}<thead><tr><th scope="col">Manager</th><th scope="col">Record</th><th scope="col">Win %</th><th scope="col">Playoffs</th><th scope="col">Titles</th></tr></thead>{% endmacro %}
    <section class="history" aria-labelledby="history-title">
      <h2 class="section-title display" id="history-title">History</h2>
      <p class="sub">Every finished season, {{ history.span }}. Records are regular-season records, median games included; playoff results count as appearances and titles.</p>
      <h3 class="h-head">Champions</h3>
      <ol class="champions" role="list">
      {% for c in history.champions %}
        <li><span class="c-season display num">{{ c.season }}</span> <span class="c-name">{{ c.manager }}</span></li>
      {% endfor %}
      </ol>
      <h3 class="h-head">All-time records</h3>
      <div class="table-scroll">
        <table class="alltime">
          {{ history_head() }}
          <tbody>
          {{ history_rows(history.current) }}
          </tbody>
        </table>
      </div>
      {% if history.former %}
      <details class="former">
        <summary>Former managers ({{ history.former|length }})</summary>
        <div class="table-scroll">
          <table class="alltime">
            {{ history_head() }}
            <tbody>
            {{ history_rows(history.former) }}
            </tbody>
          </table>
        </div>
      </details>
      {% endif %}
      <h3 class="h-head">{{ history.last_season }} luck</h3>
      <p class="h-line">Luckiest: <strong>{{ history.luckiest.manager }}</strong>, {{ history.luckiest.record }} with {{ history.luckiest.expected }} expected wins ({{ history.luckiest.luck }}).</p>
      <p class="h-line">Unluckiest: <strong>{{ history.unluckiest.manager }}</strong>, {{ history.unluckiest.record }} with {{ history.unluckiest.expected }} expected wins ({{ history.unluckiest.luck }}).</p>
      <h3 class="h-head">Highest weekly score</h3>
      <p class="h-line"><strong>{{ history.high_score.points }}</strong> by {{ history.high_score.manager }}, week {{ history.high_score.week }} of {{ history.high_score.season }}.</p>
    </section>
    {% endif %}
    <section class="how" aria-labelledby="how-title">
    {% for s in how_it_works %}
      {% if loop.first %}<h2 class="section-title display" id="how-title">{{ s.heading }}</h2>{% else %}<h3 class="how-head">{{ s.heading }}</h3>{% endif %}
      {% for p in s.paragraphs if p %}
      <p>{{ p }}</p>
      {% endfor %}
    {% endfor %}
    </section>
  </div>
</main>
{% for v in earlier %}
<template id="week-{{ v.week }}" data-title="{{ v.title }}">
{{ week_sections(v) }}
</template>
{% endfor %}
<script type="application/json" id="chart-theme">{{ chart_theme|safe }}</script>
<script>
{% include "page.js" %}
</script>
<script>
{% include "charts.js" %}
</script>
</body>
</html>
