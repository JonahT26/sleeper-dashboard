# Virtual environment
.venv/

# Cached Sleeper data (re-downloaded at most once a day)
data/cache/

# Raw Sleeper JSON stays off GitHub (it holds managers' personal settings); re-downloaded every run
data/raw/*
!data/raw/.gitkeep

# Python build and bytecode files
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Dashboard build output (published by GitHub Actions, never committed)
site/

# Tool caches
.pytest_cache/
.ipynb_checkpoints/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
